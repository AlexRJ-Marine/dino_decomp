{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": ["notes/STATE.md"],

  "mcp": {
    "servers": {
      "ghidra": {
        "type": "remote",
        "url": "http://127.0.0.1:8000/mcp",
        "oauth": false,
        "timeout": {
          "startup": 60000,
          "catalog": 60000,
          "execution": 1800000
        }
      }
    }
  },

  "permissions": [
    { "action": "edit", "resource": "original/**", "effect": "deny" },
    { "action": "edit", "resource": "game/**", "effect": "deny" },
    { "action": "edit", "resource": "analysis/**", "effect": "deny" },
    { "action": "edit", "resource": "*.iso", "effect": "deny" },

    { "action": "shell", "resource": "*Remove-Item -Recurse*", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "*git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "*git clean -fdx*", "effect": "deny" },
    { "action": "shell", "resource": "*git push*", "effect": "deny" },

    { "action": "external_directory", "resource": "C:/Tools/**", "effect": "allow" },
    { "action": "external_directory", "resource": "C:\\Tools\\**", "effect": "allow" }
  ],

  "watcher": {
    "ignore": ["game/**", "original/**", "analysis/**", ".venv/**", "build/**"]
  }
}
