{
  "version": 6,
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "Portable MinGW-w64 (w64devkit)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/Tools/w64devkit/w64devkit/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Tools/w64devkit/w64devkit/bin/g++.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw",
      "configurePreset": "mingw"
    }
  ]
}
